# Sentinel Environment Variables
# Copy to .env and configure for your environment

# ──────── ENGINE CONFIGURATION ────────
SENTINEL_CONFIG_PATH=./config/config_motor.json
SENTINEL_LOG_PATH=./data/log_sistema.txt
SENTINEL_LOG_LEVEL=INFO
SENTINEL_TIMEOUT=30

# ──────── DATA SOURCES ────────
# Yahoo Finance (yfinance is default, no config needed)
YFINANCE_TIMEOUT=10

# ──────── NOTIFICATIONS (OPTIONAL) ────────
# Email/SMTP Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=sentinel@slnit.com.br
SMTP_TO=ops@slnit.com.br

# ──────── WEBHOOKS (OPTIONAL) ────────
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-endpoint.com/anomalies
WEBHOOK_SECRET=your-webhook-secret

# ──────── SLACK INTEGRATION (OPTIONAL) ────────
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#ops-alerts

# ──────── DATABASE (OPTIONAL) ────────
# PostgreSQL
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel
DB_USER=sentinel_user
DB_PASSWORD=strong_password

# ──────── REDIS (OPTIONAL) ────────
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ──────── MONITORING (OPTIONAL) ────────
# Prometheus metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=8000

# ──────── LOGGING (OPTIONAL) ────────
LOG_FORMAT=json
LOG_OUTPUT_FILE=./logs/sentinel.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# ──────── SECURITY ────────
# Enable HTTPS for API (if applicable)
ENABLE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# ──────── DEBUG ────────
DEBUG_MODE=false
DEBUG_SQL=false
